-.schedule-gap, .schedule-conflict { margin-left: 72px; }
-.schedule-gap { min-height: 28px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; color: var(--text-soft); font-size: 10px; }
