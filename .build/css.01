nt-weight: 700; letter-spacing: -.01em; }
+.card-stage { min-width: 0; position: relative; margin-top: 1px; justify-self: start; }
+.stage-pill { max-width: 100%; width: fit-content; min-height: 29px; padding: 5px 9px; border: 0; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; background: var(--stage-tint); color: #34363b; font-size: 11px; font-weight: 680; white-space: nowrap; }
+.stage-pill > .icon:first-child { width: 14px; height: 14px; color: var(--stage-color); }
+.stage-pill--button { cursor: pointer; transition: filter .15s, box-shadow .15s, transform .12s; }
+.stage-pill--button:hover { filter: saturate(1.06) brightness(.985); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--stage-color) 22%, transparent); }
+.stage-pill--button:active { transform: scale(.98); }
+.stage-pill--button > .icon:last-child { width: 11px; height: 11px; color: #73767e; }
+.stage-menu { position: absolute; z-index: 30; top: calc(100% + 7px); left: 0; width: 190px; padding: 6px; border: 1px solid var(--line); border-radius: 13px; background: rgba(255,255,255,.98); box-shadow: var(--shadow-lg); }
+.stage-menu-option { width: 100%; min-height: 36px; padding: 7px 9px; border: 0; border-radius: 9px; background: transparent; display: flex; align-items: center; gap: 8px; color: #34363b; font-size: 12px; text-align: left; }
+.stage-menu-option:hover, .stage-menu-option.is-current { background: var(--stage-tint); }
+.stage-menu-option .icon { color: var(--stage-color); width: 15px; height: 15px; }
+.card-main { min-width: 0; display: flex; margin-top: 1px; flex-direction: column; gap: 7px; }
 .card-heading { min-width: 0; display: flex; align-items: center; gap: 8px; justify-content: space-between; }
-.card-heading h2 { overflow: hidden; margin: 0; font-size: 14px; line-height: 1.25; font-weight: 680; letter-spacing: -.015em; text-overflow: ellipsis; white-space: nowrap; }
-.card-actions { display: flex; align-items: center; gap: 2px; }
-.card-actions .icon-button { width: 30px; height: 30px; }
-.lock-badge { width: 28px; height: 28px; display: grid; place-items: center; color: var(--accent); }
-.card-meta { min-width: 0; display: flex; gap: 16px; color: var(--text-soft); font-size: 10.5px; }
+.card-heading h2 { overflow: hidden; margin: 0; font-size: 14.5px; line-height: 1.25; font-weight: 690; letter-spacing: -.016em; text-overflow: ellipsis; white-space: nowrap; }
+.card-actions { display: flex; align-items: center; gap: 2px; flex: 0 0 auto; }
+.lock-button { width: 36px; height: 36px; border: 0; border-radius: 9px; display: grid; place-items: center; background: transparent; color: #c1c3c8; transition: color .15s, background .15s, transform .12s; }
+.lock-button:hover { color: #747881; background: var(--surface-muted); }
+.lock-button.is-locked { color: var(--danger); background: var(--danger-soft); }
+.lock-button.is-locked:hover { color: #b92336; background: #ffe6e9; }
+.lock-button:active { transform: scale(.96); }
+.lock-button .icon { width: 17px; height: 17px; }
+.card-actions .icon-button { width: 38px; height: 38px; }
+.card-menu-wrap { position: relative; }
+.card-menu-toggle .icon { width: 20px; height: 20px; }
+.card-menu-toggle.is-active, .card-menu-toggle:hover { color: #42454c; background: var(--surface-muted); }
+.card-menu { position: absolute; z-index: 32; top: calc(100% + 5px); right: 0; width: 168px; padding: 6px; border: 1px solid var(--line); border-radius: 12px; background: rgba(255,255,255,.99); box-shadow: var(--shadow-lg); }
+.card-menu button { width: 100%; min-height: 38px; padding: 7px 9px; border: 0; border-radius: 8px; background: transparent; display: flex; align-items: center; gap: 9px; color: #3c3f45; font-size: 12px; text-align: left; }
+.card-menu button:hover { background: var(--surface-muted); }
+.card-menu .delete-card-activity { color: var(--danger); }
+.card-menu .icon { width: 15px; height: 15px; }
+.card-meta { min-width: 0; display: flex; gap: 14px; color: #686b73; font-size: 10.5px; }
 .card-meta > span { min-width: 0; display: inline-flex; align-items: center; gap: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.card-meta > span:first-child { flex: 1 1 auto; }
+.card-meta > span:last-child { flex: 0 1 auto; }
 .card-meta .icon { width: 13px; height: 13px; }
-.meta-count { display: inline-block; padding: 1px 5px; border-radius: 999px; background: var(--surface-muted); color: #666971; font-weight: 700; }
-.resize-handle { position: absolute; left: 42px; right: 8px; bottom: 0; height: 12px; border: 0; background: transparent; display: grid; place-items: end center; opacity: 0; touch-action: none; }
-.resize-handle span { width: 32px; height: 3px; margin-bottom: 3px; border-radius: 999px; background: #b8bac1; }
+.people-summary { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
+.people-avatars { display: inline-flex; align-items: center; padding-left: 2px; }
+.person-avatar { width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; border: 1.5px solid #fff; color: #3c3f46; font-size: 8px; font-weight: 760; line-height: 1; box-shadow: 0 0 0 1px rgba(24,24,27,.04); }
+.people-avatars .person-avatar + .person-avatar { margin-left: -5px; }
+.person-avatar--1 { background: #efeaff; color: #5940c7; }
+.person-avatar--2 { background: #e8f3ff; color: #27679d; }
+.person-avatar--3 { background: #e9f6ec; color: #3d704a; }
+.person-avatar--4 { background: #fff0e6; color: #98592d; }
+.people-more { min-width: 22px; height: 22px; margin-left: -4px; padding: 0 5px; border-radius: 999px; display: inline-grid; place-items: center; border: 1.5px solid #fff; background: #f1f1ef; color: #656870; font-size: 8px; font-weight: 750; }
+.people-names { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.people-empty { color: #8d9097; }
+.card-conflict-note { position: absolute; left: 48px; right: 12px; bottom: 6px; display: flex; align-items: center; gap: 5px; color: #b92336; font-size: 9px; font-weight: 650; pointer-events: none; }
+.card-conflict-note .icon { width: 12px; height: 12px; }
+.resize-handle { position: absolute; left: 43px; right: 8px; bottom: -1px; height: 13px; border: 0; background: transparent; display: grid; place-items: end center; opacity: 0; touch-action: none; cursor: ns-resize; }
+.resize-handle span { width: 34px; height: 3px; margin-bottom: 3px; border-radius: 999px; background: #b0b3ba; }
 .activity-card:hover .resize-handle, .resize-handle:focus-visible, .activity-card.is-resizing .resize-handle { opacity: 1; }
-.activity-card.is-resizing { box-shadow: 0 0 0 2px rgba(20,120,242,.72), var(--shadow-lg); z-index: 4; }
