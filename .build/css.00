--- a/styles.css
+++ b/styles.css
@@ -88,56 +88,98 @@
 #add-activity { display: none; }
 
 .timeline { position: relative; }
-.timeline-labels { display: grid; grid-template-columns: 62px 1fr; gap: 10px; padding: 0 3px 8px; color: var(--text-soft); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
-.activity-list { position: relative; display: flex; flex-direction: column; gap: 8px; }
-.activity-row { display: grid; grid-template-columns: 62px minmax(0,1fr); gap: 10px; min-width: 0; position: relative; }
-.timeline-time { position: relative; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end; padding: 5px 10px 5px 0; min-height: var(--card-height, 80px); color: var(--text-soft); font-size: 9px; font-variant-numeric: tabular-nums; line-height: 1.2; }
-.timeline-time::after { content: ''; position: absolute; top: 10px; bottom: -18px; right: 0; width: 1px; background: var(--line-strong); }
-.timeline-dot { position: absolute; right: -3px; top: 50%; width: 7px; height: 7px; border-radius: 50%; background: var(--bg); border: 1.5px solid #b4b6b0; z-index: 1; }
-
-.activity-card { position: relative; min-height: var(--card-height, 80px); border: 0; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); display: grid; grid-template-columns: 28px 3px minmax(92px, 130px) minmax(104px, 150px) minmax(0,1fr); align-items: center; gap: 10px; padding: 11px 12px 11px 7px; transition: transform .16s ease, box-shadow .16s ease, min-height .12s ease, opacity .12s ease; overflow: hidden; }
-.activity-card:focus-visible { outline: 3px solid rgba(20,120,242,.28); outline-offset: 1px; }
-.activity-card--conflict { background: linear-gradient(90deg, rgba(255,240,242,.72), #fff 24%); }
-.drag-handle { align-self: stretch; width: 28px; border: 0; background: transparent; display: grid; place-items: center; border-radius: 8px; color: #a1a4ad; touch-action: none; }
-.drag-handle:hover:not(:disabled) { background: var(--surface-muted); color: #777b84; }
-.drag-dots { width: 12px; display: grid; grid-template-columns: repeat(2, 3px); gap: 3px; justify-content: center; }
+.timeline-labels { display: grid; grid-template-columns: 72px 1fr; gap: 12px; padding: 0 4px 10px; color: #777a82; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; }
+.timeline-canvas { position: relative; min-height: 320px; }
+.timeline-ruler { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
+.timeline-ruler::before { content: ''; position: absolute; top: 0; bottom: 0; left: 72px; width: 1px; background: var(--line-strong); }
+.timeline-tick { position: absolute; left: 0; right: 0; height: 1px; color: #8a8d94; font-variant-numeric: tabular-nums; }
+.timeline-tick span { position: absolute; right: calc(100% - 62px); transform: translateY(-50%); white-space: nowrap; text-align: right; }
+.timeline-tick i { position: absolute; left: 66px; top: 0; height: 1px; background: var(--line-strong); }
+.timeline-tick--hour span { color: #50535a; font-size: 12px; font-weight: 680; letter-spacing: -.01em; }
+.timeline-tick--hour i { left: 64px; right: 0; background: #d9dad6; }
+.timeline-tick--half span { color: #73767e; font-size: 10.5px; font-weight: 620; }
+.timeline-tick--half i { width: 18px; }
+.timeline-tick--quarter span { color: #9699a0; font-size: 9.5px; font-weight: 520; }
+.timeline-tick--quarter i { width: 10px; background: #e1e2de; }
+.timeline-plan { position: absolute; inset: 0 0 0 84px; z-index: 2; }
+.activity-row { position: absolute; top: var(--row-top); left: 0; right: 0; height: var(--row-height); min-width: 0; z-index: 2; padding: 3px 0; transition: top .18s ease, height .16s ease, transform .16s ease; }
+.activity-row--menu-open { z-index: 30; }
+.activity-row--conflict { z-index: 8; transform: translateX(8px); right: 8px; }
+.activity-card { position: relative; width: 100%; height: 100%; min-height: 36px; border: 1px solid transparent; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-sm); display: grid; grid-template-columns: 30px 3px minmax(96px, 130px) minmax(112px, 150px) minmax(0,1fr); align-items: start; gap: 11px; padding: 10px 12px 9px 7px; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease, opacity .12s ease; overflow: visible; cursor: default; }
+.activity-card:hover { box-shadow: 0 5px 20px rgba(24,24,27,.07), 0 1px 2px rgba(24,24,27,.04); }
+.activity-card.is-selected { border-color: #1580ff; box-shadow: 0 0 0 2px rgba(21,128,255,.14), 0 8px 24px rgba(24,24,27,.08); }
+.activity-card:focus-visible { outline: 3px solid rgba(20,120,242,.25); outline-offset: 2px; }
+.activity-card--conflict { border-color: #ef7383; background: linear-gradient(90deg, #fff4f5, #fff 30%); box-shadow: 0 0 0 2px rgba(220,52,72,.08), var(--shadow-sm); }
+.drag-handle { align-self: start; width: 30px; height: 40px; border: 0; background: transparent; display: grid; place-items: center; border-radius: 8px; color: #9da0a8; touch-action: none; cursor: grab; transition: color .15s, background .15s, transform .15s; }
+.drag-handle:hover:not(:disabled) { background: #f2f2f0; color: #5e626b; }
+.drag-handle:active:not(:disabled), body.is-reordering .drag-handle:not(:disabled) { cursor: grabbing; }
+.drag-handle:disabled { cursor: default; opacity: .3; }
+.drag-dots { width: 13px; display: grid; grid-template-columns: repeat(2, 3px); gap: 3px; justify-content: center; }
 .drag-dots i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; display: block; }
-.accent-rule { width: 3px; height: 58%; min-height: 34px; max-height: 58px; border-radius: 999px; background: var(--accent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 6%, transparent); }
-.card-time { min-width: 0; display: flex; flex-direction: column; gap: 4px; font-variant-numeric: tabular-nums; }
-.card-time-range { color: var(--text-soft); font-size: 10px; white-space: nowrap; }
-.card-time strong { font-size: 12px; font-weight: 700; letter-spacing: -.01em; }
-.card-stage { min-width: 0; }
-.stage-pill { max-width: 100%; width: fit-content; min-height: 28px; padding: 5px 9px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; background: var(--stage-tint); color: color-mix(in srgb, var(--stage-color) 82%, #1c1c1e); font-size: 11px; font-weight: 650; white-space: nowrap; }
-.stage-pill .icon { width: 14px; height: 14px; }
-.card-main { min-width: 0; display: flex; flex-direction: column; gap: 7px; }
+.accent-rule { width: 3px; height: 58px; min-height: 24px; max-height: 68px; margin-top: 2px; border-radius: 999px; background: var(--accent); }
+.card-time { min-width: 0; display: flex; margin-top: 2px; flex-direction: column; gap: 4px; font-variant-numeric: tabular-nums; }
+.card-time-range { color: #676a72; font-size: 11px; white-space: nowrap; }
