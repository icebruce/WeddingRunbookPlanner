.drag-handle { align-self: stretch; width: 28px; border: 0; background: transparent; display: grid; place-items: center; border-radius: 8px; color: #a1a4ad; touch-action: none; }
.drag-handle:hover:not(:disabled) { background: var(--surface-muted); color: #777b84; }
.drag-dots { width: 12px; display: grid; grid-template-columns: repeat(2, 3px); gap: 3px; justify-content: center; }
.drag-dots i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; display: block; }
.accent-rule { width: 3px; height: 58%; min-height: 34px; max-height: 58px; border-radius: 999px; background: var(--accent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 6%, transparent); }
.card-time { min-width: 0; display: flex; flex-direction: column; gap: 4px; font-variant-numeric: tabular-nums; }
.card-time-range { color: var(--text-soft); font-size: 10px; white-space: nowrap; }
.card-time strong { font-size: 12px; font-weight: 700; letter-spacing: -.01em; }
.card-stage { min-width: 0; }
.stage-pill { max-width: 100%; width: fit-content; min-height: 28px; padding: 5px 9px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; background: var(--stage-tint); color: color-mix(in srgb, var(--stage-color) 82%, #1c1c1e); font-size: 11px; font-weight: 650; white-space: nowrap; }
.stage-pill .icon { width: 14px; height: 14px; }
.card-main { min-width: 0; display: flex; flex-direction: column; gap: 7px; }
.card-heading { min-width: 0; display: flex; align-items: center; gap: 8px; justify-content: space-between; }
.card-heading h2 { overflow: hidden; margin: 0; font-size: 14px; line-height: 1.25; font-weight: 680; letter-spacing: -.015em; text-overflow: ellipsis; white-space: nowrap; }
.card-actions { display: flex; align-items: center; gap: 2px; }
.card-actions .icon-button { width: 30px; height: 30px; }
.lock-badge { width: 28px; height: 28px; display: grid; place-items: center; color: var(--accent); }
.card-meta { min-width: 0; display: flex; gap: 16px; color: var(--text-soft); font-size: 10.5px; }
.card-meta > span { min-width: 0; display: inline-flex; align-items: center; gap: 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-meta .icon { width: 13px; height: 13px; }
.meta-count { display: inline-block; padding: 1px 5px; border-radius: 999px; background: var(--surface-muted); color: #666971; font-weight: 700; }
.resize-handle { position: absolute; left: 42px; right: 8px; bottom: 0; height: 12px; border: 0; background: transparent; display: grid; place-items: end center; opacity: 0; touch-action: none; }
.resize-handle span { width: 32px; height: 3px; margin-bottom: 3px; border-radius: 999px; background: #b8bac1; }
.activity-card:hover .resize-handle, .resize-handle:focus-visible, .activity-card.is-resizing .resize-handle { opacity: 1; }
.activity-card.is-resizing { box-shadow: 0 0 0 2px rgba(20,120,242,.72), var(--shadow-lg); z-index: 4; }

.schedule-gap, .schedule-conflict { margin-left: 72px; }
.schedule-gap { min-height: 28px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px; color: var(--text-soft); font-size: 10px; }
.schedule-gap span { height: 1px; background: repeating-linear-gradient(90deg, var(--line-strong) 0 4px, transparent 4px 8px); }
.schedule-gap strong { font-weight: 650; }
.schedule-conflict { min-height: 36px; padding: 8px 10px; border-radius: 10px; display: flex; align-items: center; gap: 8px; background: var(--danger-soft); color: #b1283a; font-size: 10.5px; }
.schedule-conflict .icon { width: 16px; height: 16px; }
.schedule-conflict strong { font-weight: 700; }
.end-marker { margin-left: 72px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px; padding: 8px 2px 0; color: var(--text-soft); font-size: 10px; }
.end-marker i { height: 1px; background: var(--line); }
.end-marker strong { font-weight: 600; }

.is-drag-source .activity-card { opacity: .2; box-shadow: none; }
.drag-floating { position: fixed !important; z-index: 1000; pointer-events: none; transform: rotate(.35deg) scale(1.012); box-shadow: var(--shadow-lg), 0 0 0 2px rgba(20,120,242,.65) !important; opacity: .98; }
.drop-placeholder { margin-left: 72px; min-height: 54px; border: 1.5px dashed #1680ff; border-radius: 12px; display: grid; place-items: center; color: #1478f2; background: rgba(20,120,242,.045); font-size: 11px; font-weight: 650; }
body.is-reordering { user-select: none; cursor: grabbing; }
.resize-tooltip { position: fixed; z-index: 1001; min-width: 62px; padding: 7px 9px; border-radius: 8px; background: #202124; color: #fff; box-shadow: var(--shadow-lg); font-size: 11px; font-weight: 700; text-align: center; pointer-events: none; }

.mobile-add { position: fixed; z-index: 35; right: 18px; bottom: calc(18px + var(--safe-bottom)); width: 52px; height: 52px; border: 0; border-radius: 50%; display: grid; place-items: center; background: #202124; color: #fff; box-shadow: 0 12px 30px rgba(24,24,27,.24); }
.mobile-add .icon { width: 22px; height: 22px; }

.conflict-banner { position: sticky; top: 64px; z-index: 32; margin: 0; padding: 10px 14px; display: flex; flex-direction: column; gap: 10px; background: #fff7e8; border-bottom: 1px solid #eed8a8; color: #704b0f; }
.conflict-banner > div:first-child { display: flex; gap: 8px; align-items: flex-start; font-size: 12px; line-height: 1.45; }
.conflict-banner .icon { margin-top: 2px; }
.conflict-actions { display: flex; gap: 8px; }
.conflict-actions .button { min-height: 34px; }

.sheet-dialog { width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; }
.sheet-dialog::backdrop { background: rgba(24,24,27,.32); backdrop-filter: blur(5px); }
.sheet { position: absolute; inset: auto 0 0; max-height: 92dvh; overflow: hidden; border-radius: 20px 20px 0 0; background: var(--surface); box-shadow: var(--shadow-lg); display: flex; flex-direction: column; padding-bottom: var(--safe-bottom); }
.sheet-header { height: 58px; padding: 0 12px; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 64px 1fr 64px; align-items: center; flex: 0 0 auto; }
.sheet-header .sheet-close { justify-self: start; }
.sheet-header h2 { margin: 0; text-align: center; font-size: 14px; font-weight: 700; letter-spacing: -.01em; }
.sheet-header .button, .sheet-header-spacer { justify-self: end; }
.sheet-body { overflow-y: auto; overscroll-behavior: contain; padding: 20px 16px 26px; }
.form-stack { display: flex; flex-direction: column; gap: 16px; }
.field { display: flex; flex-direction: column; gap: 7px; }
.field > span { color: var(--text-soft); font-size: 11px; font-weight: 620; }
.field input, .field select, .field textarea { width: 100%; border: 1px solid var(--line-strong); border-radius: 10px; background: #fff; padding: 10px 11px; outline: 0; font-size: 14px; transition: border-color .15s, box-shadow .15s; }
.field input, .field select { min-height: 42px; }
.field textarea { resize: vertical; line-height: 1.45; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: #96b6dc; box-shadow: 0 0 0 3px rgba(20,120,242,.10); }
.field input[readonly] { background: var(--surface-muted); color: var(--text-soft); }
.field small { color: var(--text-soft); font-size: 10px; line-height: 1.4; }
.field-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 12px; }
.stepper { display: grid; grid-template-columns: 38px 1fr 38px; }
